+            scanner.cancelConnection(peripheral)
+        }
+        llog("handy-frei: released BLE link, pairing kept")
+    }
+
+    /// Lets the phone connect again after the watch hands the sensor back.
+    public func resumeRadioAfterHandoff() {
+        guard radioHandedToWatch || UserDefaults.standard.bool(forKey: Self.radioHandoffKey) else { return }
+        radioHandedToWatch = false
+        UserDefaults.standard.set(false, forKey: Self.radioHandoffKey)
+        llog("handy-frei: phone may connect again")
+        if state.blePIN != nil, state.sensorSerial != nil {
+            scheduleReconnect()
+        }
+    }
