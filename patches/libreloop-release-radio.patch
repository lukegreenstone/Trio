+    /// Drops this phone's BLE link so the watch can be the Libre 3's one central.
+    /// The sensor is not ended, the keychain item is not deleted, and the saved
+    /// serial, address, and pin stay.
+    public func releaseRadioKeepingPairing() {
+        radioHandedToWatch = true
+        UserDefaults.standard.set(true, forKey: Self.radioHandoffKey)
+        cancelReconnect()
+        monitor?.stop()
+        monitor = nil
+        guard eventListenerTask != nil else {
+            llog("handy-frei: no live central, pairing kept")
+            return
+        }
+        scanner.stopScan()
+        if let id = state.peripheralID,
